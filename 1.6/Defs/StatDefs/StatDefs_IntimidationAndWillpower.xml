				<!-- <factor>0.25</factor> -->
			<!-- </li> -->
		<!-- </parts> -->
	</StatDef>
	
	
	
	<StatDef>
		<defName>SWCPStat_Willpower</defName>
		<label>willpower</label>
		<description>This stat decreases the chances that a pawn will be successfully intimidated by an ability. Also serves as a modifier to the duration of some revival abilities.</description>
		<descriptionHyperlinks>
			<AbilityDef MayRequire="guy762.Lee.KotORPotF">SWCP_Ability_ThugLeaderChallenge</AbilityDef>
			<AbilityDef MayRequire="guy762.Lee.KotORPotF">SWPotFAbility_Feat_intimidate</AbilityDef>
			<AbilityDef MayRequire="guy762.Lee.KotORPotF">SWPotFAbility_Feat_intimidate_adv</AbilityDef>
			<AbilityDef MayRequire="guy762.Lee.KotORPotF">SWPotFAbility_Feat_intimidate_AoE</AbilityDef>
			<AbilityDef MayRequire="guy762.Lee.KotORPotF">SWPotFAbility_Feat_secondwind</AbilityDef>
			<AbilityDef MayRequire="guy762.Lee.KotORPotF">SWPotFAbility_Feat_secondwind_adv</AbilityDef>
			<AbilityDef MayRequire="guy762.Lee.KotORPotF">SWPotFAbility_Feat_secondwind_mst</AbilityDef>
		</descriptionHyperlinks>
		<category>SWCPStatCategory</category>
		<displayPriorityInCategory>10</displayPriorityInCategory>
		
		<showOnPawns>true</showOnPawns>
		<!-- <showOnDefaultValue>false</showOnDefaultValue> -->
		<!-- <neverDisabled>true</neverDisabled> -->
		<!-- <alwaysHide>false</alwaysHide> -->
		<!-- <showIfUndefined>false</showIfUndefined> -->
		<!-- <hideAtValue>0</hideAtValue> -->
		

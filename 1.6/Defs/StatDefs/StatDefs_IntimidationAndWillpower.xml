<Defs>


	<StatDef>
		<defName>SWCPStat_IntimidationPower</defName>
		<label>intimidation power</label>
		<description>This stat increases the chances that a pawn can intimidate others through abilities.</description>
		<descriptionHyperlinks>
			<AbilityDef MayRequire="guy762.Lee.KotORPotF">SWCP_Ability_ThugLeaderChallenge</AbilityDef>
			<AbilityDef MayRequire="guy762.Lee.KotORPotF">SWPotFAbility_Feat_intimidate</AbilityDef>

		</descriptionHyperlinks>
		<category>SWCPStatCategory</category>
		<displayPriorityInCategory>10</displayPriorityInCategory>
		
		<showOnPawns>true</showOnPawns>
		<!-- <showOnDefaultValue>false</showOnDefaultValue> -->
		<!-- <neverDisabled>true</neverDisabled> -->
		<!-- <alwaysHide>false</alwaysHide> -->
		<!-- <showIfUndefined>false</showIfUndefined> -->
		<!-- <hideAtValue>0</hideAtValue> -->
		
		<defaultBaseValue>0.5</defaultBaseValue>
		<minValue>0</minValue>
		<toStringStyle>PercentZero</toStringStyle>
		<skillNeedOffsets>
			<li Class="SkillNeed_BaseBonus">
				<skill>Melee</skill>
				<baseValue>0.1</baseValue>
				<bonusPerLevel>0.0125</bonusPerLevel>
			</li>
			<li Class="SkillNeed_BaseBonus">
				<skill>Social</skill>
				<baseValue>0.05</baseValue>
				<bonusPerLevel>0.025</bonusPerLevel>

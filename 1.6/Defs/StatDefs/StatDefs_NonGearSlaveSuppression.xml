<Defs>

	<StatDef>
		<defName>SWCPStat_NonGearSlaveSuppressionOffset</defName>
		<label>slave suppression offset from non-gear</label>
		<description>An offset applied to the pawn's slave suppression. Higher values suppress slaves longer, while lower values make slaves rebel more often.</description>
		<category>SWCPStatCategory</category>
		<defaultBaseValue>0</defaultBaseValue>
		<hideAtValue>0</hideAtValue>
		
		<alwaysHide>true</alwaysHide>
		
		<toStringStyle>PercentZero</toStringStyle>
		<showOnAnimals>false</showOnAnimals>
		<displayPriorityInCategory>3600</displayPriorityInCategory>
		<!-- <showIfUndefined>false</showIfUndefined> -->
		<!-- <showOnPawns>false</showOnPawns> -->
	</StatDef>


</Defs>
			<li Class="StatPart_Mood">
				<factorFromMoodCurve>
					<points>
						<li>(0,0.5)</li>
							<li>(0.25,0.75)</li>
								<li>(0.5,1)</li>
							<li>(0.75,1.5)</li>
						<li>(1,2)</li>
					</points>
				</factorFromMoodCurve>
			</li>
			<li Class="StatPart_Slave" MayRequire="Ludeon.RimWorld.Ideology">
				<factor>0.25</factor>
			</li>

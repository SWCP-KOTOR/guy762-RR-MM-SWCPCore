	<HediffDef Name="SWCPNPCPackageHediff_needdisabler" ParentName="SWCPHediff_NPCPackageBASE">
		<defName>SWCPNPCPackageHediff_needdisabler</defName>
		<label>NPC Package: need disabler</label>
		<description>This is a debug hediff that disables a pawn's hunger, rest, and various other needs.\n\nThis hediff will be removed if the pawn is downed, killed, or changes factions.</description>
		<stages>
			<li>
				<minSeverity>0</minSeverity>
				<becomeVisible>false</becomeVisible>
				<statOffsets>
					<ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
					<ComfyTemperatureMax>100</ComfyTemperatureMax>
					<ComfyTemperatureMin>-100</ComfyTemperatureMin>
				</statOffsets>
				<disablesNeeds>
					<li>Food</li>
					<li>Rest</li>
					
					<li>Joy</li>
					<li>Beauty</li>
					<li>Comfort</li>
					<li>DrugDesire</li>
					<li>Outdoors</li>
					<li>Indoors</li>
				</disablesNeeds>
			</li>
		</stages>
	</HediffDef>
	
	
	<HediffDef Name="SWCPNPCPackageHediff_boredguard" ParentName="SWCPNPCPackageHediff_needdisabler">
		<defName>SWCPNPCPackageHediff_boredguard</defName>
		<label>NPC Package: bored guard</label>
		<description>This is a debug hediff that disables a various needs and sets stats according to a specific role.\n\nThis pawn has the role of a bored, inattentive guard.\n\nThis hediff will be removed if the pawn is downed, killed, or changes factions.</description>
		<stages Inherit="False">
			<li>
				<minSeverity>0</minSeverity>
				<becomeVisible>false</becomeVisible>
				<disablesNeeds>
					<li>Food</li>
					<li>Rest</li>
					
					<li>Joy</li>
					<li>Beauty</li>
					<li>Comfort</li>
					<li>DrugDesire</li>
					<li>Outdoors</li>
					<li>Indoors</li>
				</disablesNeeds>
				
				<statOffsets>
					<SWCPStat_Awareness>-0.2</SWCPStat_Awareness>
					<SWCPStat_Willpower>-0.2</SWCPStat_Willpower>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>
	
	
	
	
